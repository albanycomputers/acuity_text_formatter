<?php

/**
 * Add default config introduced in 1.x-1.3.0.
 */
function acuity_text_formatter_update_1300() {
  $settings_config = config('acuity_text_formatter.settings');

  if ($settings_config->get('capitalize_mc') === NULL) {
    $settings_config->set('capitalize_mc', TRUE);
  }

  if ($settings_config->get('custom_replacements') === NULL) {
    $settings_config->set('custom_replacements', []);
  }

  $settings_config->save();

  $titles_config = config('acuity_text_formatter.titles');
  $assignments = $titles_config->get('assignments');

  if ($assignments === NULL) {
    $assignments = [];
  }

  foreach ($assignments as $type => $settings) {
    if (!isset($assignments[$type]['collapse_spaces'])) {
      $assignments[$type]['collapse_spaces'] = TRUE;
    }
  }

  $titles_config->set('assignments', $assignments)->save();

  $users_config = config('acuity_text_formatter.users');
  $name_settings = $users_config->get('name');

  if ($name_settings === NULL) {
    $name_settings = [
      'trim' => FALSE,
      'case_transform' => 'none',
      'collapse_spaces' => TRUE,
    ];
  }
  elseif (!isset($name_settings['collapse_spaces'])) {
    $name_settings['collapse_spaces'] = TRUE;
  }

  $users_config->set('name', $name_settings)->save();
}

/**
 * Implements hook_uninstall().
 */
function acuity_text_formatter_uninstall() {
  $config_directory = config_get_config_directory('active');

  $config_files = [
    'acuity_text_formatter.settings.json',
    'acuity_text_formatter.titles.json',
    'acuity_text_formatter.users.json',
  ];

  foreach ($config_files as $config_file) {
    $file_path = $config_directory . '/' . $config_file;

    if (file_exists($file_path)) {
      unlink($file_path);
      watchdog('acuity_text_formatter', 'File %file has been deleted during uninstall.', ['%file' => $file_path], WATCHDOG_NOTICE);
    }
  }
}
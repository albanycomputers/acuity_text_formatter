  // 1. Define the Parent Container: Acuity Utils
  $items['admin/config/acuity-utils'] = [
    'title' => 'Acuity Utils',
    'description' => 'Acuity standalone utilities configuration.',
    'page callback' => 'system_admin_menu_block_page',
    'access arguments' => ['access administration pages'],
    'file' => 'system.admin.inc',
    'file path' => backdrop_get_path('module', 'system'),
    'position' => 'right',
    'weight' => -10,
  ];

  // 2. The Text Formatter Settings Page (Main List)
  $items['admin/config/acuity-utils/acuity_text'] = [
    'title' => 'Text Formatter Settings',
    'description' => 'Configure proper case transformation options.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['acuity_text_formatter_admin_form'],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_NORMAL_ITEM,
    'weight' => 10,
  ];

  // --- Custom Replacements Actions ---

  $items['admin/config/acuity-utils/acuity_text/add'] = [
    'title' => 'Add Custom Replacement',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['acuity_text_formatter_edit_form'],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_CALLBACK,
  ];

  $items['admin/config/acuity-utils/acuity_text/edit/%'] = [
    'title' => 'Edit Custom Replacement',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['acuity_text_formatter_edit_form', 5], // Pass ID from URL
    'access arguments' => ['administer site configuration'],
    'type' => MENU_CALLBACK,
  ];

  $items['admin/config/acuity-utils/acuity_text/delete/%'] = [
    'title' => 'Delete Custom Replacement',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['acuity_text_formatter_delete_form', 5],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_CALLBACK,
  ];

  // --- Title Assignment Actions ---

  $items['admin/config/acuity-utils/acuity_text/assign-title'] = [
    'title' => 'Assign Formatting to Title',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['acuity_text_formatter_assign_title_form'],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_CALLBACK,
  ];

  $items['admin/config/acuity-utils/acuity_text/edit-title/%'] = [
    'title' => 'Edit Title Formatting',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['acuity_text_formatter_edit_title_form', 5], // Content Type
    'access arguments' => ['administer site configuration'],
    'type' => MENU_CALLBACK,
  ];

  $items['admin/config/acuity-utils/acuity_text/remove-title/%'] = [
    'title' => 'Remove Title Formatting',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['acuity_text_formatter_remove_title_form', 5], // Content Type
    'access arguments' => ['administer site configuration'],
    'type' => MENU_CALLBACK,
  ];

  return $items;
}

/**
 * Implements hook_node_presave().
 */
function acuity_text_formatter_node_presave(Node &$node) {
  $entity_type = 'node';
  $bundle = $node->type;

  // --- 1. Handle Title Formatting ---
  // Load title assignments configuration
  $title_config = config('acuity_text_formatter.titles');
  $assignments = $title_config->get('assignments');

  if (isset($assignments[$bundle])) {
    $rules = $assignments[$bundle];

    // Process Title
    $text = $node->title;

    if (!empty($rules['trim'])) {
      $text = trim($text);
    }

    $case_transform = !empty($rules['case_transform']) ? $rules['case_transform'] : 'none';

    switch ($case_transform) {
      case 'lowercase':
        $text = strtolower($text);
        break;
      case 'uppercase':
        $text = strtoupper($text);
        break;
      case 'camelcase':
        $text = _acuity_text_formatter_apply_casing($text, FALSE);
        break;
      case 'intercapped':
        $text = _acuity_text_formatter_apply_casing($text, TRUE);
        break;
    }

    $node->title = $text;
  }

  // --- 2. Handle Field Formatting (Standard Widget) ---
  $instances = field_info_instances($entity_type, $bundle);

  foreach ($instances as $field_name => $instance) {
    $field = field_info_field($field_name);

    if (!in_array($field['type'], ['text', 'text_long', 'text_with_summary'])) {
      continue;
    }

    if (empty($instance['widget']['type']) || $instance['widget']['type'] !== 'acuity_text_formatter_widget') {
      continue;
    }

    $settings = isset($instance['widget']['settings']) ? $instance['widget']['settings'] : [];
    $format_settings = isset($settings['acuity_formatter_settings']) ? $settings['acuity_formatter_settings'] : [];

    $trim = !empty($format_settings['trim']);
    $case_transform = !empty($format_settings['case_transform']) ? $format_settings['case_transform'] : 'none';

    if (!$trim && $case_transform === 'none') {
      continue;
    }

    $items = field_get_items($entity_type, $node, $field_name);
    if (empty($items)) {
      continue;
    }

    foreach ($items as $delta => $item) {
      if (!isset($item['value'])) {
        continue;
      }
      $text = $item['value'];

      if ($trim) {
        $text = trim($text);
      }

      switch ($case_transform) {
        case 'lowercase':
          $text = strtolower($text);
          break;
        case 'uppercase':
          $text = strtoupper($text);
          break;
        case 'camelcase':
          $text = _acuity_text_formatter_apply_casing($text, FALSE);
          break;
        case 'intercapped':
          $text = _acuity_text_formatter_apply_casing($text, TRUE);
          break;
      }
      $node->{$field_name}['und'][$delta]['value'] = $text;
    }
  }
}

/**
 * Helper function for Case transformation.
 */
function _acuity_text_formatter_apply_casing($text, $full_intercap = TRUE) {
  $config = config('acuity_text_formatter.settings');
  $original_length = strlen($text);
  $text = ucwords(strtolower(trim($text)));
  $text .= '   ';

  if ($config->get('capitalize_after_hyphen')) {
    $text = preg_replace_callback('/-(\w)/', function ($m) { return '-' . strtoupper($m[1]); }, $text);
  }
  if ($config->get('capitalize_after_apostrophe')) {
    $text = preg_replace_callback("/'([^s ])/", function ($m) { return "'" . strtoupper($m[1]); }, $text);
  }
  if ($config->get('capitalize_after_brackets')) {
    $text = preg_replace_callback('/\((\w)/', function ($m) { return '(' . strtoupper($m[1]); }, $text);
  }
  if ($config->get('capitalize_after_period')) {
    $text = preg_replace_callback('/\.(\s*)(\w)/', function ($m) { return '.' . $m[1] . strtoupper($m[2]); }, $text);
  }
  if ($config->get('capitalize_after_newline')) {
    $text = preg_replace_callback('/(\r\n|\r|\n)(\s*)(\w)/', function ($m) { return $m[1] . $m[2] . strtoupper($m[3]); }, $text);
  }

  if ($full_intercap) {
    $text = preg_replace_callback('/\b(Mc|Mac)(?!hin|h\b|ro|re)([a-z])/', function ($m) {
       return $m[1] . strtoupper($m[2]);
    }, $text);
  }

  $replacements = $config->get('custom_replacements') ?: [];
  foreach ($replacements as $entry) {
    if (!empty($entry['search']) && isset($entry['replace'])) {
      $text = str_ireplace($entry['search'], $entry['replace'], $text);
    }
  }

  return rtrim(substr($text, 0, $original_length));
}

/**
 * Implements hook_form_FORM_ID_alter() for field_ui_field_edit_form.
 */
function acuity_text_formatter_form_field_ui_field_edit_form_alter(&$form, &$form_state) {
  if (isset($form['#instance']) && $form['#instance']['widget']['type'] === 'acuity_text_formatter_widget') {
    if (isset($form['instance']['settings']['text_processing'])) {
      $form['instance']['settings']['text_processing']['#type'] = 'value';
      $form['instance']['settings']['text_processing']['#value'] = 0;
      $form['instance']['settings']['acuity_processing_note'] = [
        '#type' => 'item',
        '#title' => t('Text processing'),
        '#markup' => t('<em>Forced to <strong>Plain text</strong> because the Acuity Text Formatter is enabled. Rich text (WYSIWYG) is incompatible with case formatting.</em>'),
        '#weight' => isset($form['instance']['settings']['text_processing']['#weight']) ? $form['instance']['settings']['text_processing']['#weight'] : 0,
      ];
    }
    if (isset($form['instance']['settings']['allowed_formats'])) {
      $form['instance']['settings']['allowed_formats']['#access'] = FALSE;
    }
    if (isset($form['instance']['settings']['better_formats'])) {
      $form['instance']['settings']['better_formats']['#access'] = FALSE;
    }
  }
}